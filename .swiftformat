--min-version 0.63.0
--swift-version 5.0

--exclude BuildTools/.build,BuildTools/.swiftpm,build,Rippple/Secrets.swift

--disable wrapMultilineStatementBraces,wrapIfStatementBodies

--binary-grouping none
--decimal-grouping none
--hex-grouping none
--ifdef no-indent
--no-space-operators ...,..<
--octal-grouping none
--pattern-let inline
--strip-unused-args closure-only
--trailing-commas never
--wrap-parameters after-first
